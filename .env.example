# Admin dashboard password (used at /admin to log in and save content)
ADMIN_PASSWORD=change-me-to-a-strong-password
# Secret used to sign the admin session cookie (any long random string)
SESSION_SECRET=please-change-this-to-a-long-random-string
# Bearer token SEOHub uses to push blog articles to POST /api/articles
HUB_TOKEN=
# Where content.json / articles.json are stored at runtime (mount a volume here)
DATA_DIR=/app/data
PORT=3000
